PORT=9000
MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=a_long_random_secret

# Comma-separated list of allowed frontend origins (leave empty in development)
CLIENT_URL=http://localhost:5173

# Cloudinary (product image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email (Gmail SMTP with an app password) for OTP and order emails
EMAIL_USER=your_email_address
EMAIL_PASS=your_email_app_password

# Used by `npm run seed` to create the admin account on a fresh database
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me

# --- AI shopping assistant (free providers) ---
# Primary provider: groq | gemini | custom. Any other provider with a key
# takes over automatically if the primary fails (rate limit, outage, retired model).
AGENT_PROVIDER=groq

# Groq: free key at https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini: free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model overrides. Leave unset to use the defaults
# (openai/gpt-oss-120b on Groq, gemini-3.8-flash on Gemini); providers retire
# models over time, so pin one only if you need to.
# GROQ_MODEL=
# GEMINI_MODEL=

# Optional: any other OpenAI-compatible endpoint (OpenRouter, Ollama, ...)
AGENT_BASE_URL=
AGENT_API_KEY=
AGENT_MODEL=
